{
  "version": 1,
  "system": "x86_64-linux",
  "virtualisation": "none",
  "uefi": {
    "supported": true,
    "platform_size": 64
  },
  "hardware": {
    "cpu": [
      {
        "architecture": "x86_64",
        "vendor_name": "GenuineIntel",
        "model_name": "Intel Xeon E-2288G",
        "cores": 16
      }
    ],
    "graphics_card": [
      {
        "class_list": ["graphics_card", "pci"],
        "driver": "i915",
        "driver_modules": ["i915"]
      }
    ],
    "network_controller": [
      {
        "class_list": ["network_controller", "pci"],
        "driver": "e1000e",
        "driver_modules": ["e1000e"]
      }
    ],
    "storage_controller": [
      {
        "class_list": ["storage_controller", "pci"],
        "driver": "ahci",
        "driver_modules": ["ahci"]
      }
    ],
    "disk": [
      {
        "class_list": ["disk", "block_device", "ide"],
        "driver": "ahci",
        "driver_modules": ["ahci", "sd_mod"]
      }
    ],
    "pci": [
      {
        "class_list": ["pci"],
        "driver": "coretemp",
        "driver_modules": ["coretemp"]
      }
    ],
    "usb_controller": [
      {
        "class_list": ["usb_controller", "pci"],
        "driver": "xhci_hcd",
        "driver_modules": ["xhci_pci", "xhci_hcd"]
      }
    ],
    "sound": [
      {
        "class_list": ["sound", "pci"],
        "driver": "snd_hda_intel",
        "driver_modules": ["snd_hda_intel"]
      }
    ]
  }
}
